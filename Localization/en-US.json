    "ui.auto.fcab2580c13c": {
      "text": "Please select FSR Frame Generation in the game options\nYou might need to select FSR first",
      "source_hash": "ee3b15d6440429b88ad5782f15527f6d67362da8eae3597688b2c77a0693137d"
    },
