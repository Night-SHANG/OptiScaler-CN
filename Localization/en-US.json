      "source_hash": "9a9ed3af75251a476b9a002559c6b4141bfebf3ea2a1962f49864785fd538fbc"
    },
    "ui.auto.d4aeeb5855b3": {
      "text": "Uses frametimes calculated by Opti",
      "source_hash": "9f9455876a7771f2a43c2403d3232add4582f56b3f07bf4a2af33ddd196fec5f"
    },
    "ui.auto.225bf215541f": {
      "text": "Let XeFG to handle frametimes",
      "source_hash": "af365ee3416e0121ef42c0c9038b8e9f6afd405e16a16e6a25154e4f906c7401"
    },
    "ui.auto.99867ef82022": {
      "text": "Select source for frametime\nMight help frame pacing and stutter issues",
      "source_hash": "62bb03ed2420ab9fe83b9d7fdb07f180430594c78bf0f331cd07eafcd355dc3c"
    },
    "ui.auto.aff808b54e2b": {
      "text": "Frame Pacing Tuning",
      "source_hash": "29020f3b431782281a693080274d821bac92360fc2c9243b1451afa0a572e6c7"
    },
    "ui.auto.d01a8cbda477": {
      "text": "Enable Tuning",
      "source_hash": "958b959e6f6f8b4cb95f8f10b00502c6892fdd6b892d04f3a42a5878fa164e0b"
    },
    "ui.auto.2edcd4b7b30b": {
