      "source_hash": "2540b744b596fbccef33ca3e82e082ea2f7b30d8253edae988e7f9609527c5f6"
    },
    "ui.auto.d7e5a24a9e72": {
      "text": "Enable Hybrid Spin",
      "source_hash": "76829b1e3139d07e96834dd9eeae1d7c2a0a8ab1b68367796f1c120594b28d05"
