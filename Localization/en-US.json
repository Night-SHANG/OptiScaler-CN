    "ui.auto.ce8f157c15fb": {
      "text": "Fix broken visuals",
      "source_hash": "bc21cdb1a2bdacb80e18c900e9f536b0be41d500dda1cb8078f19e5696975075"
    },
    "ui.auto.f9ad1c27cdc8": {
      "text": "Makes a copy of the depth buffer\nCan fix broken visuals in some games on AMD GPUs under Windows\nCan cause stutters, so best to use only when necessary",
      "source_hash": "0cbd4c8ae58d4ca966a08f8b9b61415abb22c8f9625c72105587ee240897fd47"
    },
    "ui.auto.7aeee1096f9b": {
      "text": "Only FSR1 and Bicubic are supported when Ratio is below 1.0.",
      "source_hash": "de864898f915add738b6d717efc85bb7b012272e0663735f146d42898391facd"
    },
    "ui.auto.59f2a904143a": {
      "text": "Opti",
      "source_hash": "c2854dc2b604da5b86929e0ee26079d5315374de737788ca7aee79cbb6b39c34"
    },
