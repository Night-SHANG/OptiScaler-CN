    "ui.auto.2ed2c6a47574": {
      "text": "FPS Overlay Enabled",
      "source_hash": "9bb96f8ba542008ea4df418e00115a387c4ec6bb86926ba30e328942c203a245"
    },
    "ui.auto.524e7769f7b8": {
      "text": "Open Wiki",
      "source_hash": "9a6868949d4ee588956c34a712868407e2058768b9e7820384efb70378eb5e75"
    },
    "ui.auto.42de5850ce6d": {
      "text": "Click to open the OptiScaler Wiki page\nin your default browser\n\nCompatibility list with known game issues\nand workarounds, FG options explained\nand other useful info",
      "source_hash": "072b285897e3e9694f96ecebb5c947bf9ca9073474ba1f9df0502a9fd1ef5c15"
    }
