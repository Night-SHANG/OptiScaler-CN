    {
      "key": "ui.auto.2a827b430d58",
      "source": "Input Colour Space",
      "source_hash": "0b259dc9bdd33eff8ea7b85faf2f89bd02bf7f5a9269164e6ff1dc30014759e0"
    },
    {
      "key": "ui.auto.fe5888fda05f",
      "source": "Select the input colour space that the game uses.\nNon-Linear / sRGB: Might improve FSR4 upscaling quality, might increase ghosting.\nPQ: Rarest, might increase ghosting and break lights.",
      "source_hash": "032103b59e7fb48e441de261bb49636d9c49c3c3f5f44b465ca02544cc755e0c"
    },
    {
      "key": "ui.auto.33e38b2c17ed",
      "source": "Value of 0.0f can improve temporal stability of bright pixels\nLower values are more stable with ghosting\nHigher values are more pixelly but less ghosting.",
      "source_hash": "6dc16a51b8445226dd859b9b350eb15effff63b00dced3ab1278255c4855412c"
    },
    {
      "key": "ui.auto.f2732b43a5f4",
      "source": "Increasing this scales fsr3.1 computed shading\nchange value at read to have higher reactiveness.",
      "source_hash": "942cfc8e8de58fe2c648b48829d786c81c53f7a9a76399f10338d53417ff1ad0"
    },
    {
      "key": "ui.auto.817c7dc1233b",
      "source": "Use generic appid with NGX\nFixes OptiScaler preset override not working with certain games\nRequires a game restart.",
      "source_hash": "2b107e621490d3e78df8cff579c7e93746000f07df5a51f1119d85c32cd8ece8"
    },
    {
      "key": "ui.auto.0009bc87576d",
      "source": "Unsupported Opti working mode",
      "source_hash": "81788b8ae42abfd41efe83ac1c1ee6f56d8b9294b3d341d32c64008be0c982ab"
    },
    {
      "key": "ui.auto.f5c1b19bff14",
