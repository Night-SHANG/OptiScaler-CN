    },
    {
      "key": "ui.auto.c83164cf4aab",
      "source": "Extended format checks for possible Hudless\nMight cause crashes and slowdowns!",
      "source_hash": "288a060692b79a13cf1a63e8bc34de66a5d131a91094047fd375df1be6aecce7"
    },
    {
      "key": "ui.auto.350b77b922a7",
      "source": "Enables capturing of resources before shader execution.\nIncrease Hudless capture chances, but might cause capturing of unnecessary resources.",
      "source_hash": "17803ccfe82788d8f7ad574b445df39db34428090fceb5ae9f8cdf872ada8e56"
    },
    {
      "key": "ui.auto.cf9ef85834fb",
      "source": "Block rarely used resources from using as Hudless \nto prevent flickers and other issues\n\nHUDfix enable/disable will reset the block list!",
      "source_hash": "233ea04be2cde237a792561f3adcd221173c15f36403b7aa51f8ca3332a64109"
    },
    {
      "key": "ui.auto.15a28dc2df8a",
      "source": "Relax resolution checks for Hudless by 32 pixels \nHelps games which use black borders for some \nresolutions and screen ratios (e.g. Witcher 3)",
      "source_hash": "c1f830205b255e1d50d0b54866dc27b22a58822601bff40a0afba73141f3107f"
    },
    {
      "key": "ui.auto.13dff5213a96",
      "source": "Please put dlssg_to_fsr3_amd_is_better.dll next to OptiScaler",
      "source_hash": "5f2ef45f8fdde44a44141a6346a5f7e66085f11cd931451ee66cd35491ed7be4"
    },
    {
      "key": "ui.auto.0318f4bcaf47",
      "source": "Using RTSS Reflex injection with AntiLag 2 and FSR FG might cause issues",
      "source_hash": "becadc4c88940c44a196d8199d498bd5b9d8cc836632f48930de33ed3db9ea9c"
    },
    {
      "key": "ui.auto.a4f290af054d",
      "source": "Using Reflex's limit with OptiFG has performance overhead",
